# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres (used by docker-compose to create the db container) ---
POSTGRES_USER=dinventa
POSTGRES_PASSWORD=dinventa
POSTGRES_DB=dinventa

# --- Prisma / app database connection ---
# Host is "db" because that's the docker-compose service name (the app
# container reaches it over the compose network, not localhost).
DATABASE_URL="postgresql://dinventa:dinventa@db:5432/dinventa?schema=public"

# --- Auth (session cookie signing key) ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Seeded admin account (created by prisma/seed.ts) ---
ADMIN_EMAIL=admin@dinventa.local
ADMIN_PASSWORD=change-me-please

# --- AI (used starting Phase 1) ---
GEMINI_API_KEY=

# Fallback LLM provider (OpenRouter, https://openrouter.ai/keys) — used when
# Gemini's quota is exhausted. Free tier, no card required.
OPENROUTER_API_KEY=

# --- Pexels (product photo lookup, https://www.pexels.com/api/) ---
# Free, instant signup, no card required. Leaving this unset falls back to
# Openverse (keyless but often irrelevant results), then picsum.photos
# (random, at least visually plausible) — see src/lib/product-image.ts.
PEXELS_API_KEY=

# --- Twilio (used starting Phase 3, AI phone order confirmation) ---
# Leaving TWILIO_ACCOUNT_SID unset makes the app use a mock call service
# instead (src/lib/calls/index.ts) — the order-confirmation flow still works,
# just without an actual phone call; use the admin "Mark confirmed"/"Mark
# declined" buttons to simulate the outcome.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public tunnel URL (ngrok/cloudflared) pointing at this app, so Twilio's
# webhooks can reach it. Changes every time the tunnel restarts.
PUBLIC_BASE_URL=

# --- ElevenLabs (Bangla TTS for the phone confirmation call) ---
# Twilio's own bn-IN <Say> voice quality is poor; ElevenLabs (eleven_v3 model
# — the only ElevenLabs model with Bengali support) speaks the call prompts
# instead when this is set, via <Play>. Leaving it unset (or if a call to
# ElevenLabs fails) falls back to Twilio's native bn-IN <Say>.
ELEVENLABS_API_KEY=
# Optional — defaults to ElevenLabs' "Rachel" premade voice if unset. Pick a
# voice from your ElevenLabs voice library that actually sounds good for
# Bangla and set its id here.
ELEVENLABS_VOICE_ID=

# --- Steadfast courier (used starting Phase 4, automatic parcel creation) ---
# From the Steadfast merchant dashboard (Settings -> API). Leaving these
# unset makes the app use a mock courier service instead
# (src/lib/courier/index.ts) — confirmed orders still move to "Shipped" with
# a fake MOCK-... tracking code, just without a real courier being created.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
