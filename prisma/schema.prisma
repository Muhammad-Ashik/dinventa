generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  DECLINED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PendingProductStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  products        Product[]
  pendingProducts PendingProduct[]
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  price       Int
  imageUrl    String
  stock       Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  @@index([categoryId])
}

model PendingProduct {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String
  price       Int
  imageUrl    String
  status      PendingProductStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  reviewedAt  DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
}

model Order {
  id               String      @id @default(cuid())
  status           OrderStatus @default(PENDING_CONFIRMATION)
  totalAmount      Int
  shippingAddress  String
  phone            String
  confirmationNote String?
  courierConsignmentId String?
  courierTrackingCode  String?
  courierNote          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        String @id @default(cuid())
  quantity  Int
  unitPrice Int

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
