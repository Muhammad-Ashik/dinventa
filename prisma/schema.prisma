generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  DECLINED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PendingProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AddressType {
  SHIPPING
  BILLING
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders    Order[]
  wishlist  WishlistItem[]
  reviews   Review[]
  addresses Address[]
}

// One saved address per type per user (a "shipping" card and a "billing"
// card, matching the account/addresses page) — not a full multi-address
// book, since checkout only ever needs one of each.
model Address {
  id        String      @id @default(cuid())
  type      AddressType
  name      String
  email     String
  phone     String
  address   String
  updatedAt DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  products        Product[]
  pendingProducts PendingProduct[]
  vettedRetailers VettedRetailer[]
}

// Per-category allow-list of retailer domains the real-product-search
// pipeline is permitted to search/fetch — checked for a clean robots.txt and
// no anti-scraping ToS clause before ever being added (see Phase 5 notes).
// Deactivate rather than delete so history/audit isn't lost.
model VettedRetailer {
  id         String   @id @default(cuid())
  name       String
  domain     String   @unique
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

// Generic admin-editable key-value store, currently just the markup rule
// ("markupMode" = "flat"|"percent", "markupValue" = stringified number) —
// kept generic rather than a fixed-column Settings table so future settings
// don't need another migration.
model AppSetting {
  key   String @id
  value String
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String
  price          Int
  // Real "was" price for a genuine promotion — nullable, only set when a
  // product is actually discounted. Must be > price when present (enforced
  // in the manual-add-product form); never auto-generated/faked.
  compareAtPrice Int?
  // Real end time for a genuine time-boxed promotion — nullable, only set
  // when compareAtPrice is also set. Drives the homepage countdown; never a
  // fake per-pageview deadline, always a real fixed timestamp.
  saleEndsAt     DateTime?
  imageUrl       String
  // Additional real photos for the quick-view gallery (imageUrl doubles as
  // the cover / first image). Empty for any product only ever given one
  // photo — the gallery just shows the single cover then, never padded with
  // repeats.
  images         String[]      @default([])
  stock          Int           @default(0)
  brand          String        @default("Generic")
  status         ProductStatus @default(ACTIVE)
  // Dropshipping sourcing fields — set when this product came from the real
  // product-search pipeline (Phase 5). Null for manually-added products.
  // sourceUrl/sourceDomain: the real retailer listing, for admin fulfillment
  // (never shown to customers). realPrice: the scraped cost before markup —
  // `price` above is always realPrice + the configured markup, applied once
  // at discovery time and never silently changed by later markup edits.
  sourceUrl         String?
  sourceDomain      String?
  realPrice         Int?
  isSubstitute      Boolean   @default(false)
  // Set by an admin-triggered re-verify (idea 22) — never auto-applied to
  // `price`; re-verify only flags a change for manual review.
  lastVerifiedAt    DateTime?
  sourceCheckStatus String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems     OrderItem[]
  wishlistedBy   WishlistItem[]
  reviews        Review[]

  @@index([categoryId])
  @@index([brand])
}

model PendingProduct {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  description    String
  price          Int
  compareAtPrice Int?
  imageUrl       String
  images         String[]             @default([])
  brand          String               @default("Generic")
  status         PendingProductStatus @default(PENDING)
  // Same sourcing fields as Product (Phase 5) — carried straight across to
  // the live Product row when approveProduct() copies this candidate over.
  sourceUrl    String?
  sourceDomain String?
  realPrice    Int?
  isSubstitute Boolean @default(false)
  createdAt      DateTime             @default(now())
  reviewedAt     DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
}

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// Only creatable for a product the reviewer actually received — see
// canReviewProduct() in src/lib/reviews.ts, which checks for a shipped/
// delivered order line before a review is allowed. Never seeded/fabricated.
model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Order {
  id               String      @id @default(cuid())
  status           OrderStatus @default(PENDING_CONFIRMATION)
  totalAmount      Int
  shippingAddress  String
  phone            String
  confirmationNote String?
  courierConsignmentId String?
  courierTrackingCode  String?
  courierNote          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        String @id @default(cuid())
  quantity  Int
  unitPrice Int
  // Snapshotted from Product.realPrice at order-creation time (idea 21) —
  // never re-derived later, so re-verifies/markup changes don't retroactively
  // alter historical profit figures.
  realUnitCost    Int?
  // Set when an admin checks off "ordered from source" on the order's
  // fulfillment checklist (idea 20) — the other two checklist steps derive
  // from existing Order.courierTrackingCode / Order.status, no new fields.
  sourceOrderedAt DateTime?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
